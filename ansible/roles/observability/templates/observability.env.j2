JENGASEC_DATA_DIR={{ obs_state_root }}/data
JENGASEC_FUNCTION_BIND={{ obs_function_bind }}
JENGASEC_GRAFANA_BIND={{ obs_grafana_bind }}
JENGASEC_GRAFANA_PORT={{ obs_grafana_port }}
JENGASEC_GRAFANA_USER={{ 472 if obs_manage_storage_ownership else ansible_user_uid }}
JENGASEC_LOOKUP_DIR={{ obs_state_root }}/lookups
JENGASEC_LOKI_USER={{ 10001 if obs_manage_storage_ownership else ansible_user_uid }}
JENGASEC_PROMETHEUS_USER={{ 65534 if obs_manage_storage_ownership else ansible_user_uid }}
JENGASEC_RETENTION_HOURS={{ obs_retention_hours }}
JENGASEC_SECRET_DIR={{ obs_config_root }}/secrets
JENGASEC_METRICS_BIND={{ obs_metrics_bind }}
JENGASEC_V2_TELEMETRY_ENVIRONMENT={{ 'rehearsal' if obs_rehearsal_mode else obs_metrics_environment }}
{% if obs_infrastructure_enabled %}
JENGASEC_INFRASTRUCTURE_RESOURCE_IDS={{ obs_metrics_targets | map(attribute='resource_id') | join(',') }}
JENGASEC_INFRASTRUCTURE_DIR={{ obs_infrastructure_config_root }}
JENGASEC_PROMETHEUS_CONFIG={{ obs_infrastructure_config_root }}/prometheus.yml
JENGASEC_WRITE_PROXY_CONFIG={{ obs_infrastructure_config_root }}/nginx.conf
JENGASEC_METRICS_TARGET_PORT=9443
{% endif %}
{% if obs_rehearsal_mode %}
COMPOSE_PROFILES=rehearsal
JENGASEC_FIXTURE_USER={{ 10001 if obs_manage_storage_ownership else ansible_user_uid }}
JENGASEC_STAFF_REHEARSAL_INTERVAL_SECONDS={{ obs_rehearsal_event_interval_seconds }}
{% endif %}
