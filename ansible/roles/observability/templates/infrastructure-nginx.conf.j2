events {}

http {
  access_log off;
  server_tokens off;

  map $ssl_client_fingerprint $infrastructure_attribution_publisher {
    default 0;
{% if obs_infrastructure_attribution_certificate_sha1 %}
    "{{ obs_infrastructure_attribution_certificate_sha1 | lower }}" 1;
{% endif %}
  }

  map $ssl_client_fingerprint $infrastructure_scoring_collector {
    default 0;
{% if obs_infrastructure_scoring_certificate_sha1 %}
    "{{ obs_infrastructure_scoring_certificate_sha1 | lower }}" 1;
{% endif %}
  }

  map $ssl_client_s_dn $infrastructure_scoring_role {
    default 0;
    "~(^|[,+])CN=jengasec-scoring-collector([,+]|$)" 1;
  }

  server {
    listen 127.0.0.1:9090;
    location = /healthz {
      add_header Content-Type text/plain;
      return 200 "ok\n";
    }
    location / { return 404; }
  }

  server {
    listen 9443 ssl;
    http2 on;
    ssl_certificate /etc/jengasec-infrastructure/tls/server/server.crt;
    ssl_certificate_key /etc/jengasec-infrastructure/tls/server/server.key;
    ssl_client_certificate /etc/jengasec-infrastructure/tls/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_body_timeout 30s;

    location = /healthz {
      add_header Content-Type text/plain;
      return 200 "ok\n";
    }

    location = /api/v1/write {
      if ($infrastructure_scoring_role = 1) { return 403; }
      if ($infrastructure_scoring_collector = 1) { return 403; }
      limit_except POST { deny all; }
      client_max_body_size 32m;
      proxy_request_buffering off;
      proxy_read_timeout 60s;
      proxy_pass http://prometheus:9090;
    }

    location = /api/v1/infrastructure-events {
      if ($infrastructure_scoring_role = 1) { return 403; }
      if ($infrastructure_scoring_collector = 1) { return 403; }
      limit_except POST { deny all; }
      client_max_body_size 8m;
      proxy_read_timeout 60s;
      proxy_pass http://vector:8687/;
    }

    location = /api/v1/infrastructure-attribution {
      if ($infrastructure_scoring_role = 1) { return 403; }
      if ($infrastructure_scoring_collector = 1) { return 403; }
      if ($infrastructure_attribution_publisher = 0) { return 403; }
      limit_except POST { deny all; }
      client_max_body_size 8m;
      proxy_read_timeout 30s;
      proxy_pass http://vector:8688/;
    }

    location = /opentelemetry.proto.collector.logs.v1.LogsService/Export {
      if ($infrastructure_scoring_role = 1) { return 403; }
      if ($infrastructure_scoring_collector = 1) { return 403; }
      limit_except POST { deny all; }
      client_max_body_size 8m;
      grpc_read_timeout 60s;
      grpc_pass grpc://vector:4317;
    }

{% if obs_infrastructure_scoring_certificate_sha1 %}
    location = /loki/api/v1/query_range {
      if ($infrastructure_scoring_role = 0) { return 403; }
      if ($infrastructure_scoring_collector = 0) { return 403; }
      if ($request_method != GET) { return 405; }
      client_max_body_size 1m;
      proxy_connect_timeout 3s;
      proxy_read_timeout 15s;
      proxy_set_header X-Scope-OrgID staff;
      proxy_set_header Authorization "";
      proxy_pass http://loki:3100;
    }

    location = /loki/api/v1/push {
      if ($infrastructure_scoring_role = 0) { return 403; }
      if ($infrastructure_scoring_collector = 0) { return 403; }
      if ($request_method != POST) { return 405; }
      client_max_body_size 1m;
      proxy_connect_timeout 3s;
      proxy_send_timeout 15s;
      proxy_read_timeout 15s;
      proxy_set_header X-Scope-OrgID staff;
      proxy_set_header Authorization "";
      proxy_pass http://loki:3100;
    }
{% endif %}

    location / { return 404; }
  }
}
