global:
  scrape_interval: 15s
  scrape_timeout: 5s
  evaluation_interval: 30s

storage:
  tsdb:
    out_of_order_time_window: 1h

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]
        labels:
          environment: {{ obs_metrics_environment | to_json }}
          resource_id: {{ obs_metrics_resource_id | to_json }}
          role: observability

  - job_name: vector
    honor_labels: true
    static_configs:
      - targets: [vector:9598]
        labels:
          environment: {{ obs_metrics_environment | to_json }}
          resource_id: {{ obs_metrics_resource_id | to_json }}
          role: observability

  - job_name: jengasec-node
    scheme: https
    follow_redirects: false
    tls_config:
      ca_file: /etc/jengasec-infrastructure/tls/ca.crt
      cert_file: /etc/jengasec-infrastructure/tls/client/client.crt
      key_file: /etc/jengasec-infrastructure/tls/client/client.key
      min_version: TLS12
    static_configs:
{% for target in obs_metrics_targets %}
      - targets: [{{ (target.address ~ ':' ~ (target.port | default(9100))) | to_json }}]
        labels:
          environment: {{ obs_metrics_environment | to_json }}
          resource_id: {{ target.resource_id | to_json }}
          role: {{ target.role | to_json }}
{% endfor %}
    metric_relabel_configs:
      - source_labels: [__name__, device]
        regex: 'node_network_.*;(veth|cali|docker|br-).*'
        action: drop
      - source_labels: [__name__, mountpoint]
        regex: 'node_filesystem_.*;/(run/(containerd|k3s|netns)|var/lib/(docker|containerd|kubelet|rancher/k3s))(/.*)?'
        action: drop
