{
  "apiVersion": "v1",
  "kind": "Secret",
  "type": "kubernetes.io/tls",
  "metadata": {
    "name": "observability-client-tls",
    "namespace": "jengasec-observability",
    "labels": {"app.kubernetes.io/component": "observability"}
  },
  "data": {
    "ca.crt": {{ lookup('ansible.builtin.file', obs_cluster_tls_ca_file) | b64encode | to_json }},
    "tls.crt": {{ lookup('ansible.builtin.file', obs_cluster_tls_cert_file) | b64encode | to_json }},
    "tls.key": {{ lookup('ansible.builtin.file', obs_cluster_tls_key_file) | b64encode | to_json }}
  }
}
