[Unit]
Description=JengaSec passive VPN intrusion detection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ obs_network_install_root }}/vendor/usr/bin/suricata --pcap={{ obs_network_interface }} -c {{ obs_network_install_root }}/suricata.yaml
Environment=LD_LIBRARY_PATH={{ obs_network_install_root }}/vendor/usr/lib/x86_64-linux-gnu:{{ obs_network_install_root }}/vendor/lib/x86_64-linux-gnu
WorkingDirectory={{ obs_network_install_root }}
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ obs_network_event_state }}/suricata
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE
MemoryMax={{ obs_network_suricata_memory_limit }}
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
