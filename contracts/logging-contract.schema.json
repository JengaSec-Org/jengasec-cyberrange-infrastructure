{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jengasec.example/contracts/logging-contract.schema.json",
  "title": "JengaSec application log line",
  "description": "One bounded JSON object per line on application stdout.",
  "type": "object",
  "required": [
    "schema_version",
    "ts",
    "level",
    "enterprise",
    "application",
    "namespace",
    "event",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 timestamp"
    },
    "level": {
      "enum": ["debug", "info", "warn", "error"]
    },
    "enterprise": {
      "enum": ["ENT-A", "ENT-B"]
    },
    "application": {
      "enum": ["APP01", "APP02", "APP03", "APP04", "APP05", "APP06", "APP07", "APP08", "APP09"]
    },
    "namespace": {
      "type": "string",
      "pattern": "^jengasec-ent-(a|b)-app0[1-9]$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "description": "Raw event name from telemetry-event-catalogue.yaml"
    },
    "outcome": {
      "enum": ["success", "failure", "denied", "error", "unknown"]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque correlation value for one request; never a credential"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_ip": {
      "oneOf": [
        {"type": "string", "format": "ipv4"},
        {"type": "string", "format": "ipv6"}
      ]
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque application account or session identifier; never a name, email or token"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Path only; omit query strings and request bodies"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "severity": {
      "enum": ["low", "medium", "high", "critical"],
      "description": "Optional producer assessment; the catalogue supplies the default"
    },
    "detail": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/detailValue"
      },
      "description": "Flat catalogue-listed values only; no secrets, identity data, bodies or nested objects"
    }
  },
  "$defs": {
    "detailScalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "detailValue": {
      "oneOf": [
        {"$ref": "#/$defs/detailScalar"},
        {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/detailScalar"}
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "2.0",
      "ts": "2026-10-10T09:15:02.113Z",
      "level": "warn",
      "enterprise": "ENT-A",
      "application": "APP03",
      "namespace": "jengasec-ent-a-app03",
      "event": "login_failure",
      "outcome": "failure",
      "request_id": "req-7f2a",
      "source_ip": "10.60.12.14",
      "user_id": "acct-1842",
      "detail": {
        "attempt": 5,
        "reason": "invalid_credentials"
      }
    }
  ]
}
