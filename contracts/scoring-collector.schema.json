{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jengasec.local/scoring-collector.schema.json",
  "title": "OBS competition measurement collector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "competition",
    "platform_url",
    "feed_token_file",
    "state_dir",
    "source_cache_bytes",
    "window_start",
    "window_end",
    "producers",
    "probes"
  ],
  "properties": {
    "schema_version": {
      "const": "scoring-collector/1.0"
    },
    "competition": {
      "type": "integer",
      "minimum": 1
    },
    "platform_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1024
    },
    "feed_token_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 512
    },
    "state_dir": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 512
    },
    "source_cache_bytes": {
      "type": "integer",
      "minimum": 1048576
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "producers": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_./:-]{1,128}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "token_file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "token_file": {
            "type": "string",
            "pattern": "^/[^\\u0000\\r\\n]+$",
            "maxLength": 512
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_./:-]{1,128}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "health_path",
          "functional_path",
          "assertions",
          "producer"
        ],
        "properties": {
          "health_path": {
            "type": "string",
            "pattern": "^/[^\\r\\n]*$",
            "maxLength": 512
          },
          "functional_path": {
            "type": "string",
            "pattern": "^/[^\\r\\n]*$",
            "maxLength": 512
          },
          "producer": {
            "type": "string",
            "maxLength": 128
          },
          "tls": {
            "type": "boolean"
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "equals"
              ],
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "equals": {
                  "type": [
                    "string",
                    "boolean",
                    "integer",
                    "null"
                  ],
                  "maxLength": 1024
                }
              }
            }
          }
        }
      }
    },
    "metrics_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 512
    },
    "loki_url": {
      "type": "string",
      "format": "uri"
    },
    "loki_headers_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 512
    },
    "infrastructure_resources": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "allow_loopback_http": {
      "type": "boolean",
      "default": false
    },
    "ai_gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "operator_token_file",
        "producer_map"
      ],
      "properties": {
        "api_prefix": {
          "enum": ["/api/v1/scoring", "/api/v1"],
          "default": "/api/v1/scoring"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "operator_token_file": {
          "type": "string",
          "pattern": "^/[^\\u0000\\r\\n]+$",
          "maxLength": 512
        },
        "producer_map": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team",
              "source_id",
              "kind",
              "producer_id",
              "clock_uncertainty_ms"
            ],
            "properties": {
              "team": {
                "type": "string",
                "maxLength": 128
              },
              "source_id": {
                "type": "string",
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "competitor",
                  "gateway",
                  "verifier"
                ]
              },
              "producer_id": {
                "type": "string",
                "format": "uuid"
              },
              "clock_uncertainty_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              }
            }
          }
        }
      }
    }
  }
}
