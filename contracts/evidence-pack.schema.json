{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jengasec.example/contracts/evidence-pack.schema.json",
  "title": "JengaSec observability evidence-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding",
    "contract_versions",
    "exported_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "enterprise",
        "application",
        "namespace",
        "start_ts",
        "end_ts",
        "telemetry_event_ids",
        "correlation_ids"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "enterprise": {
          "enum": ["ENT-A", "ENT-B"]
        },
        "application": {
          "type": "string",
          "pattern": "^APP0[1-9]$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^jengasec-ent-(a|b)-app0[1-9]$"
        },
        "start_ts": {
          "type": "string",
          "format": "date-time"
        },
        "end_ts": {
          "type": "string",
          "format": "date-time"
        },
        "telemetry_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evt_[a-f0-9]{64}$"
          }
        },
        "correlation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        }
      }
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_pack",
        "finding",
        "telemetry",
        "platform_audit",
        "competition_events"
      ],
      "properties": {
        "evidence_pack": {
          "const": "1.0"
        },
        "finding": {
          "const": 1
        },
        "telemetry": {
          "const": "2.0"
        },
        "platform_audit": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        },
        "competition_events": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry.ndjson",
        "platform-audit.ndjson",
        "competition-events.ndjson"
      ],
      "properties": {
        "telemetry.ndjson": {
          "$ref": "#/$defs/file"
        },
        "platform-audit.ndjson": {
          "$ref": "#/$defs/file"
        },
        "competition-events.ndjson": {
          "$ref": "#/$defs/file"
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "sha256"],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
