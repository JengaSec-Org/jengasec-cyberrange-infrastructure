+def service_matches(service, role, side, category):
+    if role in ('judge','infrastructure_staff'): return bool(service.get('staff'))
+    return side in service.get('sides',[]) and category in service.get('categories',[])
+
+
+def service_flows(cur):
+    """(source, endpoint, proto, ports, participant, service id) for every active participant and matching service."""
+    if not PLATFORM_SERVICES: return []
+    cur.execute("""SELECT host(v.vpn_address) source_ip,p.participant_id,p.role,t.side,t.category
+                   FROM participants p JOIN vpn_allocations v USING(participant_id) LEFT JOIN teams t ON t.team_id=p.team_id
+                   WHERE p.status='active' AND p.eligible=true AND v.status='active' AND v.vpn_address IS NOT NULL""")
+    rows=cur.fetchall(); result=[]
+    for s in PLATFORM_SERVICES:
+        dest=str(ipaddress.ip_address(s['endpoint'])); proto=s.get('protocol','tcp').lower()
+        ports=sorted(set(int(x) for x in s['ports']))
+        if proto not in ('tcp','udp') or not ports or any(x<1 or x>65535 for x in ports): raise ProvisionError(f"Invalid platform service {s.get('id')}")
+        for row in rows:
+            if service_matches(s,row['role'],row['side'],row['category']):
+                result.append((row['source_ip'],dest,proto,ports,row['participant_id'],s['id']))
+    return result
+
+
+def has_platform_service(role, side, category):
+    return any(service_matches(s,role,side,category) for s in PLATFORM_SERVICES)
