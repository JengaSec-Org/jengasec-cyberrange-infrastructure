{
  "version": 1,
  "group": "jengasec-infrastructure",
  "interval_seconds": 60,
  "rules": [
    {
      "uid": "jengasec-host-unavailable",
      "title": "Host metrics unavailable",
      "query": "(1 - up{job=\"jengasec-node\",environment=\"live\"}) or on (resource_id) (absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm101\"}) or absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm102\"}) or absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm103\"}) or absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm104\"}) or absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm105\"}) or absent(up{job=\"jengasec-node\",environment=\"live\",resource_id=\"vm106\"}))",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 2,
      "summary": "An expected host exporter is unavailable or missing. Check the affected target and its certificate before trusting host health."
    },
    {
      "uid": "jengasec-host-stale",
      "title": "Host metrics stale",
      "query": "time() - jengasec_collection_timestamp_seconds{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 120,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 3,
      "summary": "Host metric refresh is more than two minutes old. Check the local collector timer and textfile output."
    },
    {
      "uid": "jengasec-collector-failed",
      "title": "Host collector failed",
      "query": "1 - jengasec_collection_success{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 4,
      "summary": "A configured local collector failed. Its component metrics are unavailable until collection recovers."
    },
    {
      "uid": "jengasec-service-unavailable",
      "title": "Expected service unavailable",
      "query": "jengasec_service_expected{environment=\"live\"} - jengasec_service_up{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 6,
      "summary": "An expected service is inactive or absent. Check service state and related infrastructure events."
    },
    {
      "uid": "jengasec-memory-pressure",
      "title": "Host memory pressure",
      "query": "1 - node_memory_MemAvailable_bytes{environment=\"live\",job=\"jengasec-node\"} / node_memory_MemTotal_bytes{environment=\"live\",job=\"jengasec-node\"}",
      "datasource": "prometheus",
      "threshold": 0.9,
      "for": "10m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 9,
      "summary": "Available memory is below ten percent. Inspect memory use before adding workload."
    },
    {
      "uid": "jengasec-cpu-saturation",
      "title": "Sustained host CPU use",
      "query": "1 - avg by (resource_id) (rate(node_cpu_seconds_total{environment=\"live\",job=\"jengasec-node\",mode=\"idle\"}[5m]))",
      "datasource": "prometheus",
      "threshold": 0.9,
      "for": "15m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 8,
      "summary": "Host CPU use has exceeded ninety percent for fifteen minutes."
    },
    {
      "uid": "jengasec-disk-space",
      "title": "Filesystem space low",
      "query": "1 - node_filesystem_avail_bytes{environment=\"live\",job=\"jengasec-node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/var/lib/(kubelet|containerd)/.*\"} / node_filesystem_size_bytes{environment=\"live\",job=\"jengasec-node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/var/lib/(kubelet|containerd)/.*\"}",
      "datasource": "prometheus",
      "threshold": 0.85,
      "for": "10m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 10,
      "summary": "A monitored filesystem has less than fifteen percent available space. Check retention and other disk consumers."
    },
    {
      "uid": "jengasec-disk-inodes",
      "title": "Filesystem inodes low",
      "query": "1 - node_filesystem_files_free{environment=\"live\",job=\"jengasec-node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/var/lib/(kubelet|containerd)/.*\"} / node_filesystem_files{environment=\"live\",job=\"jengasec-node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/var/lib/(kubelet|containerd)/.*\"}",
      "datasource": "prometheus",
      "threshold": 0.95,
      "for": "10m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 10,
      "summary": "A monitored filesystem has less than five percent free inodes."
    },
    {
      "uid": "jengasec-postgres-pressure",
      "title": "PostgreSQL connection pressure",
      "query": "jengasec_postgres_connections{environment=\"live\"} / jengasec_postgres_max_connections{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0.85,
      "for": "10m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 13,
      "summary": "Database connections exceed eighty-five percent of the configured limit."
    },
    {
      "uid": "jengasec-postgres-locks",
      "title": "PostgreSQL locks waiting",
      "query": "jengasec_postgres_waiting_locks{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "5m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 14,
      "summary": "Database locks have waited across sustained samples. Inspect the database before changing capacity."
    },
    {
      "uid": "jengasec-postgres-deadlocks",
      "title": "New PostgreSQL deadlocks",
      "query": "increase(jengasec_postgres_deadlocks_total{environment=\"live\"}[5m])",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "1m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-infrastructure",
      "panel_id": 16,
      "summary": "New database deadlocks occurred during the recent five-minute window. This alert clears when the counter stops increasing."
    },
    {
      "uid": "jengasec-vpn-down",
      "title": "VPN interface unavailable",
      "query": "1 - jengasec_wireguard_interface_up{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "2m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-network",
      "panel_id": 2,
      "summary": "The configured VPN interface is down. Zero or idle peers alone do not trigger this rule."
    },
    {
      "uid": "jengasec-cluster-not-ready",
      "title": "Kubernetes node not ready",
      "query": "1 - k8s_node_condition_ready{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 2,
      "summary": "A cluster node reports NotReady. Inspect conditions, resource pressure and recent events."
    },
    {
      "uid": "jengasec-cluster-missing",
      "title": "Kubernetes telemetry missing",
      "query": "absent(k8s_node_condition_ready{environment=\"live\",cluster=\"red\"}) or absent(k8s_node_condition_ready{environment=\"live\",cluster=\"blue\"})",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 3,
      "summary": "An expected cluster has no fresh readiness metric. A quiet or empty workload is not a substitute for collector health."
    },
    {
      "uid": "jengasec-cluster-pressure",
      "title": "Kubernetes node pressure",
      "query": "max by (cluster,node) ({__name__=~\"k8s_node_condition_memory_pressure|k8s_node_condition_disk_pressure|k8s_node_condition_pid_pressure\",environment=\"live\"})",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "5m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 4,
      "summary": "Kubernetes reports sustained memory, disk or PID pressure."
    },
    {
      "uid": "jengasec-deployment-unavailable",
      "title": "Kubernetes replicas unavailable",
      "query": "k8s_deployment_desired{environment=\"live\"} - k8s_deployment_available{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "5m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 6,
      "summary": "A deployment has fewer available replicas than desired."
    },
    {
      "uid": "jengasec-container-restarts",
      "title": "Repeated container restarts",
      "query": "clamp_min(delta(k8s_container_restarts{environment=\"live\"}[15m]), 0)",
      "datasource": "prometheus",
      "threshold": 3,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 7,
      "summary": "A container restart gauge increased by more than three in fifteen minutes. Gauge resets alone do not trigger this rule."
    },
    {
      "uid": "jengasec-cluster-export-failed",
      "title": "Cluster metric export failing",
      "query": "sum by (cluster,exporter) (increase(otelcol_exporter_send_failed_metric_points_total{environment=\"live\"}[5m]))",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 13,
      "summary": "Metric export failures continue across recent windows. Check receiver availability and the persistent queue."
    },
    {
      "uid": "jengasec-cluster-queue-high",
      "title": "Cluster collector queue filling",
      "query": "otelcol_exporter_queue_size{environment=\"live\"} / otelcol_exporter_queue_capacity{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0.8,
      "for": "5m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-kubernetes",
      "panel_id": 12,
      "summary": "A collector exporter queue is over eighty percent full."
    },
    {
      "uid": "jengasec-central-unavailable",
      "title": "Central telemetry target unavailable",
      "query": "(1 - up{job=~\"prometheus|vector\",environment=\"live\"}) or absent(up{job=\"prometheus\",environment=\"live\"}) or absent(up{job=\"vector\",environment=\"live\"})",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "2m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 2,
      "summary": "A central metrics target is unavailable or missing."
    },
    {
      "uid": "jengasec-contract-rejections",
      "title": "Recent telemetry contract rejections",
      "query": "sum(increase(jengasec_contract_rejections_total{environment=\"live\"}[5m]))",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "2m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 5,
      "summary": "The pipeline rejected new inputs. Inspect sanitized rejection reasons; old counter totals do not keep this rule active."
    },
    {
      "uid": "jengasec-event-delivery-stale",
      "title": "Host event delivery stale",
      "query": "time() - jengasec_event_agent_last_delivery_timestamp_seconds{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 180,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 14,
      "summary": "An event agent has not completed a delivery for more than three minutes. Quiet sources still send collector health records."
    },
    {
      "uid": "jengasec-event-collection-stale",
      "title": "Host event collection stale",
      "query": "time() - jengasec_event_agent_last_collect_timestamp_seconds{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 180,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 15,
      "summary": "A host event agent has stopped advancing its collection timestamp."
    },
    {
      "uid": "jengasec-event-loss",
      "title": "Host event loss reported",
      "query": "increase(jengasec_event_agent_dropped_total{environment=\"live\"}[5m])",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "1m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 16,
      "summary": "The event agent reports new dropped records. Inspect queue capacity and loss events."
    },
    {
      "uid": "jengasec-event-errors",
      "title": "Host event collection errors",
      "query": "increase(jengasec_event_agent_collection_errors_total{environment=\"live\"}[5m])",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "2m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 18,
      "summary": "New collection errors were reported by a host event agent."
    },
    {
      "uid": "jengasec-serious-ids",
      "title": "Serious IDS observations",
      "query": "sum by (resource_id) (count_over_time({record_family=\"infrastructure_telemetry\",environment=\"live\",event_type=\"ids.alert\",severity=~\"high|critical\"}[5m]))",
      "datasource": "loki",
      "threshold": 0,
      "for": "1m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "OK",
      "dashboard_uid": "jengasec-network",
      "panel_id": 9,
      "summary": "Recent high or critical IDS observations require investigation. Detection alone does not establish a score."
    },
    {
      "uid": "jengasec-provisioning-stale",
      "title": "Provisioning attribution unavailable",
      "query": "(1 - (jengasec_provisioning_refresh_success{environment=\"live\"} * jengasec_provisioning_snapshot_usable{environment=\"live\"} * ((jengasec_provisioning_snapshot_expires_timestamp_seconds{environment=\"live\"} - time()) > bool 0) * ((time() - jengasec_provisioning_last_attempt_timestamp_seconds{environment=\"live\"}) < bool 120))) or on(resource_id,mode) (absent(jengasec_provisioning_snapshot_usable{environment=\"live\",mode=\"source\",resource_id=\"vm103\"}) or absent(jengasec_provisioning_snapshot_usable{environment=\"live\",mode=\"cache\",resource_id=\"vm104\"}))",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "2m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 20,
      "summary": "The native provisioning snapshot is missing, failed or expired. Treat current attribution as unknown until source and cache recover."
    },
    {
      "uid": "jengasec-spool-cleanup-stale",
      "title": "Auxiliary spool cleanup unavailable",
      "query": "((time() - jengasec_auxiliary_spool_last_success_timestamp_seconds{environment=\"live\",resource_id=\"vm104\"}) > bool 180) or absent(jengasec_auxiliary_spool_last_success_timestamp_seconds{environment=\"live\",resource_id=\"vm104\"})",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 25,
      "summary": "Auxiliary spool maintenance is missing or stale. Inspect its timer and filesystem permissions."
    },
    {
      "uid": "jengasec-spool-cap-excess",
      "title": "Auxiliary spool cap exceeded",
      "query": "jengasec_auxiliary_spool_excess_bytes{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "5m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 24,
      "summary": "Auxiliary spool files remain above their configured byte cap. Inspect incoming rate and cleanup before disk pressure grows."
    },
    {
      "uid": "jengasec-wal-storage-paused",
      "title": "Collector paused for storage",
      "query": "jengasec_observability_wal_guard_paused{environment=\"live\"}",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "1m",
      "keep_firing_for": "1m",
      "severity": "critical",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 28,
      "summary": "A collector was paused at its WAL limit or disk-space floor. Review its retained queue and the storage guard before explicitly resuming."
    },
    {
      "uid": "jengasec-wal-guard-unavailable",
      "title": "Collector storage guard unavailable",
      "query": "((1 - jengasec_observability_wal_guard_check_success{environment=\"live\"}) + clamp_min(time() - jengasec_observability_wal_guard_last_check_timestamp_seconds{environment=\"live\"} - 120, 0)) or absent(jengasec_observability_wal_guard_last_check_timestamp_seconds{environment=\"live\",resource_id=\"vm105\"}) or absent(jengasec_observability_wal_guard_last_check_timestamp_seconds{environment=\"live\",resource_id=\"vm106\"})",
      "datasource": "prometheus",
      "threshold": 0,
      "for": "3m",
      "keep_firing_for": "1m",
      "severity": "warning",
      "no_data_state": "NoData",
      "dashboard_uid": "jengasec-telemetry-health",
      "panel_id": 29,
      "summary": "The storage guard failed or stopped checking collector WAL usage. Inspect its timer and private configuration."
    }
  ]
}
