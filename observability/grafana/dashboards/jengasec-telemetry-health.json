      "title": "Discarded records in the recent window",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Records discarded by a component. Correlate with contract rejections and collector loss events.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
