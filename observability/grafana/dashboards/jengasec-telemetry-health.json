      "title": "Collection and loss events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 10
      },
      "description": "Collector self-observations and explicit loss reports. A healthy process alone is not end-to-end evidence.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No matching events",
