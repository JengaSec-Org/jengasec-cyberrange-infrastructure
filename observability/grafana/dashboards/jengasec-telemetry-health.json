  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "live, validation, rehearsal, unclassified",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "live"
          ],
          "value": [
            "live"
          ]
        },
        "options": [
          {
            "text": "live",
            "value": "live",
            "selected": true
          },
          {
            "text": "validation",
            "value": "validation",
            "selected": false
          },
          {
            "text": "rehearsal",
            "value": "rehearsal",
            "selected": false
          },
          {
            "text": "unclassified",
            "value": "unclassified",
            "selected": false
          }
        ]
      },
      {
        "name": "resource",
        "label": "Resource",
        "type": "custom",
        "query": "vm101, vm102, vm103, vm104, vm105, vm106",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "vm101",
            "value": "vm101",
            "selected": false
          },
          {
            "text": "vm102",
            "value": "vm102",
            "selected": false
          },
          {
            "text": "vm103",
            "value": "vm103",
            "selected": false
          },
          {
            "text": "vm104",
            "value": "vm104",
            "selected": false
          },
          {
            "text": "vm105",
            "value": "vm105",
            "selected": false
          },
          {
            "text": "vm106",
            "value": "vm106",
            "selected": false
          }
        ]
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "query": "red, blue",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "red",
            "value": "red",
            "selected": false
          },
          {
            "text": "blue",
            "value": "blue",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Separate quiet, missing and failing",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "A healthy input must have a fresh collector and successful delivery. **No matching events** can be quiet; **Missing signal** requires checking configuration or collection. Delivery counters report attempts acknowledged by each destination, while event panels show records queried from storage. Website publication, attribution and external owner feeds may be unconfigured without blocking host metrics."
      }
    },
    {
      "id": 2,
      "title": "Central scrape targets",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failing",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Scraped",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"prometheus|vector\",environment=~\"${environment:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Host metric age",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Missing signal",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - jengasec_collection_timestamp_seconds{environment=~\"${environment:regex}\",resource_id=~\"${resource:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{resource_id}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Collection result",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failing",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Collected",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jengasec_collection_success{environment=~\"${environment:regex}\",resource_id=~\"${resource:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{resource_id}} {{collector}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Recent contract rejections",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Rejected input counter increase. Missing series is not a claim that validation passed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jengasec_contract_rejections_total{environment=~\"${environment:regex}\"}[$__range]))",
          "editorMode": "code",
          "legendFormat": "{{resource_id}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Delivery by destination",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Accepted deliveries by destination. Disabled optional destinations have no series; quiet destinations can report zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component_id) (rate(vector_component_sent_events_total{component_kind=\"sink\",environment=~\"${environment:regex}\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "{{component_id}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Vector buffered events",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Queued events. Sustained growth means a sink is not keeping up.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
