      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Records returned by native storage queries, independent of delivery counters.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No matching events",
          "color": {
            "mode": "palette-classic"
