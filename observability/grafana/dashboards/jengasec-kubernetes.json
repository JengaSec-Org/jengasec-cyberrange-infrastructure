          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Node disk pressure",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
