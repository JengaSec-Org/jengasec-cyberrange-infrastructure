{
  "uid": "jengasec-kubernetes",
  "id": null,
  "title": "JengaSec \u00b7 Kubernetes",
  "description": "Cluster and workload health with persistent collector queues. Red and blue clusters stay independently visible.",
  "tags": [
    "jengasec",
    "staff",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "link",
      "title": "Overview",
      "url": "/d/jengasec-overview",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Team Activity",
      "url": "/d/jengasec-observability",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Infrastructure & Services",
      "url": "/d/jengasec-infrastructure",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Kubernetes",
      "url": "/d/jengasec-kubernetes",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Network & Security",
      "url": "/d/jengasec-network",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Event Investigation & Evidence",
      "url": "/d/jengasec-investigation",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Telemetry Health",
      "url": "/d/jengasec-telemetry-health",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "live, validation, rehearsal, unclassified",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "live"
          ],
          "value": [
            "live"
          ]
        },
        "options": [
          {
            "text": "live",
            "value": "live",
            "selected": true
          },
          {
            "text": "validation",
            "value": "validation",
            "selected": false
          },
          {
            "text": "rehearsal",
            "value": "rehearsal",
            "selected": false
          },
          {
            "text": "unclassified",
            "value": "unclassified",
            "selected": false
          }
        ]
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "query": "red, blue",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "red",
            "value": "red",
            "selected": false
          },
          {
            "text": "blue",
            "value": "blue",
            "selected": false
          }
        ]
      },
      {
        "name": "resource",
        "label": "Resource",
        "type": "custom",
        "query": "vm101, vm102, vm103, vm104, vm105, vm106",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "vm101",
            "value": "vm101",
            "selected": false
          },
          {
            "text": "vm102",
            "value": "vm102",
            "selected": false
          },
          {
            "text": "vm103",
            "value": "vm103",
            "selected": false
          },
          {
            "text": "vm104",
            "value": "vm104",
            "selected": false
          },
          {
            "text": "vm105",
            "value": "vm105",
            "selected": false
          },
          {
            "text": "vm106",
            "value": "vm106",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cluster coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Both clusters should publish a fresh node readiness value and collector health. Namespace and workload labels describe infrastructure, not participant identity. A quiet event list is valid only when collection is healthy. Missing values mean collection is absent, stale or unconfigured."
      }
    },
    {
      "id": 2,
      "title": "Node readiness",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_node_condition_ready{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{cluster}} / {{node}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Metrics age",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Age of the newest node readiness sample per cluster. No sample is Missing signal.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Missing signal",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (cluster) (timestamp(k8s_node_condition_ready{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}))",
          "editorMode": "code",
          "legendFormat": "{{cluster}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Node memory pressure",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Clear",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Pressure",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_node_condition_memory_pressure{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{cluster}} / {{node}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
