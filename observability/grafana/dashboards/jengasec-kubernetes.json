    {
      "id": 6,
      "title": "Desired / available deployment replicas",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Desired replicas compared with available replicas. Empty clusters may have no application deployments.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_deployment_desired{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{cluster}} {{namespace}} / {{workload}} {{__name__}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "k8s_deployment_available{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{cluster}} {{namespace}} / {{workload}} {{__name__}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "New container restarts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Positive change in the restart gauge over the preceding five minutes. The window allows for collection and delivery intervals. A reset or a replacement pod does not count as new restarts. Missing samples remain unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster,namespace,pod) (clamp_min(delta(k8s_container_restarts{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}[5m]), 0))",
          "editorMode": "code",
          "legendFormat": "{{cluster}} {{namespace}} / {{pod}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Pod phase",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Kubernetes reported phase. A Running pod may still be unready; compare availability and warnings.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending",
                  "color": "orange",
                  "index": 0
                },
                "2": {
                  "text": "Running",
                  "color": "green",
                  "index": 1
                },
                "3": {
                  "text": "Succeeded",
                  "color": "blue",
                  "index": 2
                },
                "4": {
                  "text": "Failed",
                  "color": "red",
                  "index": 3
                },
                "5": {
                  "text": "Unknown",
                  "color": "gray",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_pod_phase{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{cluster}} {{namespace}} / {{pod}}",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "resource_id",
                "role",
                "service",
                "collector",
                "cluster",
                "namespace",
                "namespace",
                "pod",
                "workload",
                "container",
                "node",
                "component_id",
                "Value"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Recent Kubernetes warnings and events",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No matching events",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{record_family=\"infrastructure_telemetry\",environment=~\"${environment:regex}\",source=\"kubernetes\"} | json cluster=\"resource.cluster\" | cluster=~\"${cluster:regex}\"",
          "editorMode": "code",
          "legendFormat": "{{resource_id}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 10,
      "title": "Workload CPU share of cluster capacity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "description": "Container CPU use divided by allocatable CPU across the cluster. Sandbox and empty container series are excluded. Host CPU remains in Infrastructure & Services.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (rate(container_cpu_usage_seconds_total{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\",container!=\"\",container!=\"POD\",pod!=\"\"}[$__rate_interval])) / sum by (cluster) (k8s_node_allocatable_cpu{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\"})",
          "editorMode": "code",
          "legendFormat": "{{cluster}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Workload memory working set",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "description": "Container working-set memory summed per cluster. Sandbox and empty container series are excluded.",
      "fieldConfig": {
