      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (container_memory_working_set_bytes{environment=~\"${environment:regex}\",cluster=~\"${cluster:regex}\",container!=\"\",container!=\"POD\",pod!=\"\"})",
          "editorMode": "code",
          "legendFormat": "{{cluster}}",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Collector queue usage",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "Exporter queue depth as a share of its configured capacity. Missing series mean this exporter does not expose a queue or is not reporting.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
