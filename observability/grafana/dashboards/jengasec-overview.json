          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Serious events",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "description": "High and critical observations in the selected time. Open Event Investigation for evidence. Check collection health before interpreting silence.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No matching events",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({record_family=\"infrastructure_telemetry\",environment=~\"${environment:regex}\",severity=~\"high|critical\"}[$__range]))",
          "editorMode": "code",
          "legendFormat": "events",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
