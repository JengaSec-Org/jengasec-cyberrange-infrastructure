{
  "uid": "jengasec-overview",
  "id": null,
  "title": "JengaSec \u00b7 Overview",
  "description": "Live fleet, important observations and collection health. Start here and open a focused view for detail.",
  "tags": [
    "jengasec",
    "staff",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "link",
      "title": "Overview",
      "url": "/d/jengasec-overview",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Team Activity",
      "url": "/d/jengasec-observability",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Infrastructure & Services",
      "url": "/d/jengasec-infrastructure",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Kubernetes",
      "url": "/d/jengasec-kubernetes",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Network & Security",
      "url": "/d/jengasec-network",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Event Investigation & Evidence",
      "url": "/d/jengasec-investigation",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "Telemetry Health",
      "url": "/d/jengasec-telemetry-health",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "live, validation, rehearsal, unclassified",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "live"
          ],
          "value": [
            "live"
          ]
        },
        "options": [
          {
            "text": "live",
            "value": "live",
            "selected": true
          },
          {
            "text": "validation",
            "value": "validation",
            "selected": false
          },
          {
            "text": "rehearsal",
            "value": "rehearsal",
            "selected": false
          },
          {
            "text": "unclassified",
            "value": "unclassified",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Fleet health",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Reachable** confirms collection. Check services and alerts below, then open a view above for details. **Missing** needs investigation; quiet traffic alone does not prove health. Use Environment to select live or test data."
      }
    },
    {
      "id": 2,
      "title": "Control plane",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "description": "Exporter reachability for vm101. Open Infrastructure & Services for CPU, memory, disk and service health.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Missing",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "Failing",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Reachable",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"jengasec-node\",environment=~\"${environment:regex}\",resource_id=\"vm101\"} or on() vector(-1)",
          "editorMode": "code",
          "legendFormat": "vm101",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": [
        {
          "title": "Open resource",
          "url": "/d/jengasec-infrastructure?var-resource=vm101&${environment:queryparam}&from=${__from}&to=${__to}"
        }
      ]
    },
