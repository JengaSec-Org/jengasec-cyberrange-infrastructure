    {
      "id": 12,
      "title": "Alerts needing attention",
      "type": "alertlist",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "description": "Grafana managed infrastructure alerts. No data and evaluation errors remain visible. Open an alert for the affected resource and recovery state.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "alertName": "",
        "alertInstanceLabelFilter": "{jengasec_managed=\"infrastructure\"}",
        "dashboardAlerts": false,
        "groupMode": "default",
        "maxItems": 15,
        "sortOrder": 1,
        "showOptions": "current",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": false,
          "noData": true,
          "error": true
        }
      }
    },
    {
      "id": 13,
      "title": "CPU use by host",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "description": "Host CPU usage, averaged over cores.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Missing signal",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
