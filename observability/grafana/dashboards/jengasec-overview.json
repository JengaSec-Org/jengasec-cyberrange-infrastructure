    {
      "id": 8,
      "title": "Fresh collectors",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "description": "A result below six means stale, failed or missing host metrics. Reachability cards show missing exporters.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((time() - jengasec_collection_timestamp_seconds{environment=~\"${environment:regex}\"}) < 120) or vector(0)",
          "editorMode": "code",
          "legendFormat": "of 6 expected hosts",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Services down",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "description": "Expected services reporting down or absent. Missing collector data is not zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Missing signal",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jengasec_service_expected{environment=~\"${environment:regex}\"} - jengasec_service_up{environment=~\"${environment:regex}\"})",
          "editorMode": "code",
          "legendFormat": "services",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "maxLines": 200,
          "direction": "backward",
          "format": "time_series"
        }
      ],
