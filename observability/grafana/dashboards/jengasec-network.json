{
  "uid": "jengasec-network",
  "id": null,
  "title": "JengaSec \u00b7 Network & Security",
  "description": "VPN, passive network flows, actual firewall decisions and IDS observations. No traffic observation grants scope or awards points.",
  "tags": [
    "jengasec",
    "staff",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "link",
      "title": "Overview",
