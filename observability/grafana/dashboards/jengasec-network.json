      },
      "targets": [
        {
          "refId": "A",
          "expr": "{record_family=\"infrastructure_telemetry\",environment=~\"${environment:regex}\",resource_id=~\"${resource:regex}\",event_type=\"network.flow\"} | json",
          "editorMode": "code",
          "legendFormat": "{{resource_id}}",
          "instant": false,
